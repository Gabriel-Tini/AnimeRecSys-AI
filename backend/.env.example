# AnimeRecSys AI - Variáveis de Ambiente
# Nunca comite o arquivo .env preenchido no repositório!

# Chave da API Google Gemini (Obrigatória para calibração semântica)
GEMINI_API_KEY=your_gemini_api_key_here

# Ambiente (development / production)
ENVIRONMENT=development

# Configurações de API
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Hiperparâmetros Padrão do Sistema de Recomendação
REC_ETA=0.15
REC_ALPHA=0.25
REC_GAMMA=0.98
REC_LAMBDA_MMR=0.5
