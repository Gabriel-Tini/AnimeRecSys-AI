{
  "hosting": {
    "public": "frontend/dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "auth": {
    "providers": {
      "anonymous": true,
      "googleSignIn": {
        "oAuthBrandDisplayName": "AnimeRecSys AI",
        "supportEmail": "hgabriel812@gmail.com"
      }
    }
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}

